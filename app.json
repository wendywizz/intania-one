{
  "expo": {
    "name": "Intania One",
    "slug": "intania-one",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "th.ac.psu.eng.scooba",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/31d71936-d7c8-435e-bc91-f7027444706a",
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "bundleIdentifier": "th.ac.psu.eng.scooba",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "The app connects to a test server inside the Faculty of Engineering network to fetch data during the testing period.",
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "th"
        ]
      }
    },
    "android": {
      "package": "th.ac.psu.eng.scooba",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#B33939",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#B33939",
          "defaultChannel": "push_alerts"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android-icon-foreground.png",
          "backgroundColor": "#B33939",
          "dark": {
            "backgroundColor": "#B33939"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app uses your photos to attach evidence for a sick leave request.",
          "cameraPermission": "The app uses your camera to capture photos as evidence of your clock-in and clock-out."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock the Intania One app."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "The app uses your location to confirm you are within the Faculty of Engineering when you clock in for official duty.",
          "locationWhenInUsePermission": "The app uses your location to confirm you are within the Faculty of Engineering when you clock in for official duty.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/with-android-scooba-network-security"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "en": "./locales/en.json",
      "th": "./locales/th.json"
    }
  }
}
