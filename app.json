{
  "expo": {
    "name": "Intania One",
    "slug": "intania-one",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "th.ac.psu.eng.scooba",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/31d71936-d7c8-435e-bc91-f7027444706a"
    },
    "ios": {
      "bundleIdentifier": "th.ac.psu.eng.scooba",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "แอปเชื่อมต่อเซิร์ฟเวอร์ทดสอบภายในเครือข่ายคณะวิศวกรรมศาสตร์ เพื่อดึงข้อมูลระหว่างช่วงทดสอบ"
      }
    },
    "android": {
      "package": "th.ac.psu.eng.scooba",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#AD1C28",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#AD1C28",
          "defaultChannel": "push_alerts"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#AD1C28",
          "dark": {
            "backgroundColor": "#AD1C28"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Intania One to access your photos so you can attach a medical certificate image.",
          "cameraPermission": "Allow Intania One to use the camera so you can photograph a medical certificate."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ใช้ Face ID เพื่อปลดล็อกแอป Intania One"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
